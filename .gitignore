# ═══════════════════════════════════════════════
# .gitignore — Racine du monorepo
# ═══════════════════════════════════════════════

# ── Environnement ────────────────────────────
.env
.env.local
.env.*.local

backend/.env
backend/.env.local
backend/.env.*

frontend/.env
frontend/.env.local
frontend/.env.*


# ── Builds (jamais commités) ─────────────────
frontend/dist/
backend/dist/

# ── Node modules ─────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/

# ── Prisma ───────────────────────────────────
backend/prisma/migrations/dev/

# ── Uploads (données utilisateurs) ───────────
backend/uploads/*
!backend/uploads/.gitkeep

# ── Logs ─────────────────────────────────────
logs/
*.log
backend/logs/

# ── Data locale ───────────────────────────
data/
backups/

# ── OS ───────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ──────────────────────────────────────
.vscode/
.idea/
*.swp